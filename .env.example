# Copy to .env and replace the API key before starting the local Compose demo.
OPSPILOT_API_KEY=replace-with-a-local-demo-key

# Fault injection is disabled unless you explicitly set this to true.
OPSPILOT_ENABLE_CHAOS_API=false

# Local-only database password; do not reuse it outside this demo.
OPSPILOT_DB_PASSWORD=local-demo-only
